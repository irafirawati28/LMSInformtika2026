{
  "name": "@kanal/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && esbuild src/app.ts --bundle --platform=node --format=esm --packages=external --outfile=app.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "provision-user": "tsx src/db/provision-user.ts",
    "migrate-files": "tsx src/db/migrate-private-files.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
