NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters-before-running
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_CERT=./supabase-ca.crt
# For hosting providers without secret files, use the base64-encoded CA cert instead.
DATABASE_CA_CERT_BASE64=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=lms-private

# In Vercel, set FRONTEND_ORIGIN to your production URL. Same-origin Vercel
# preview URLs are also accepted by the CSRF middleware.
